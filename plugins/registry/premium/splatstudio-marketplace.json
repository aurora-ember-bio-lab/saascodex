{
  "$schema": "https://splatstudio.app/schemas/marketplace.v1.json",
  "specVersion": "1.0.0",
  "name": "splatstudio-premium",
  "version": "1.0.0",
  "owner": {
    "name": "Aurora Ember Cyber Bio Lab",
    "url": "https://splatstudio.app/premium"
  },
  "metadata": {
    "description": "Premium (licensed) plugin registry. Entries are discoverable when the workspace is entitled per commercial-core/entitlements.json; unentitled workspaces see them locked and must activate a key.",
    "version": "1.0.0"
  },
  "plugins": [
    {
      "name": "premium/pro-design-suite",
      "title": "Pro Design Suite",
      "version": "1.0.0",
